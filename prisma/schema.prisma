// Prisma schema — YouTube Content Planner
// Каналы (свои, не чужие) и видео на них, которые двигаются по этапам
// производства: идея → сценарий → съёмка → монтаж → готово → опубликовано.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum VideoStage {
  IDEA      // идея
  SCRIPT    // сценарий
  FILMING   // съёмка
  EDITING   // монтаж
  READY     // готово к публикации
  PUBLISHED // опубликовано
  REJECTED  // отклонено
}

model Channel {
  id        String   @id @default(cuid())
  name      String   @unique
  niche     String?  // короткое описание ниши
  notes     String?
  createdAt DateTime @default(now())

  videos    Video[]
}

model Video {
  id               String     @id @default(cuid())
  channelId        String
  channel          Channel    @relation(fields: [channelId], references: [id], onDelete: Cascade)

  title            String
  idea             String?    // питч/описание идеи
  script           String?    // текст сценария
  isShort          Boolean    @default(true) // Shorts (вертикальное, до 60 сек) или обычное видео
  stage            VideoStage @default(IDEA)
  plannedPublishAt DateTime?
  publishedAt      DateTime?
  videoUrl         String?
  notes            String?

  // Путь к готовому файлу видео на диске — приложение работает локально, так
  // что загрузка на YouTube просто читает файл по этому пути, без отдельного
  // хранилища.
  videoFilePath    String?
  youtubeVideoId   String?
  privacyStatus    String     @default("unlisted") // private | unlisted | public

  voiceoverPath    String?    // публичный URL сгенерированной озвучки (/voiceovers/{id}.mp3)

  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  stageEvents      VideoStageEvent[]

  @@index([channelId, stage])
}

// История смены этапов — когда и как видео переходило между стадиями.
model VideoStageEvent {
  id        String     @id @default(cuid())
  videoId   String
  video     Video      @relation(fields: [videoId], references: [id], onDelete: Cascade)
  stage     VideoStage
  note      String?
  createdAt DateTime   @default(now())

  @@index([videoId])
}

// Единственная строка — OAuth-токен подключённого YouTube-аккаунта
// (single-user приложение, отдельная таблица per-user не нужна).
model GoogleAuthToken {
  id           String   @id @default("singleton")
  accessToken  String
  refreshToken String
  expiryDate   DateTime
  channelTitle String?  // название YouTube-канала, для отображения "подключено как …"
  updatedAt    DateTime @updatedAt
}
