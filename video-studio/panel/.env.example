# Переменные панели — в Vercel: Project → Settings → Environment Variables (Production).
# Локально: скопируйте в .env.local (он не попадает в git).

# Пароль входа в панель: длинный и не такой, как от почты.
PANEL_PASSWORD=
# Случайная строка от 32 символов — подпись входа (новая строка выкидывает все входы).
# Получить: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Fine-grained токен GitHub (github.com/settings/personal-access-tokens/new), доступ только
# к репозиторию yt-planner. Права: Actions — Read and write, Contents — Read and write,
# Variables — Read and write, Secrets — Read-only (только имена — какие ключи заданы).
GITHUB_TOKEN=
GITHUB_REPO=Magamed56/yt-planner
GITHUB_BRANCH=master

# Те же, что в video-studio/.env (npm run youtube-auth). Google-проект — «In production»,
# иначе ключ умирает через 7 дней.
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# Любая случайная строка: Vercel передаёт её в ежедневный запуск автопилота (/api/cron).
CRON_SECRET=
