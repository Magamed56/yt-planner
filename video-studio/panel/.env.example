# Переменные панели — в Vercel: Project → Settings → Environment Variables (Production).
# Локально: скопируйте в .env.local (он не попадает в git).

# Пароль входа в панель: длинный и не такой, как от почты.
PANEL_PASSWORD=
# Случайная строка от 32 символов — подпись входа (новая строка выкидывает все входы).
# Получить: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Fine-grained токен GitHub (github.com/settings/personal-access-tokens/new), доступ только
# к репозиторию yt-planner. Права: Actions — Read and write, Contents — Read and write,
# Variables — Read and write, Secrets — Read-only (только имена — какие ключи заданы).
GITHUB_TOKEN=
GITHUB_REPO=Magamed56/yt-planner
GITHUB_BRANCH=master

# Те же, что в video-studio/.env (npm run youtube-auth). Google-проект — «In production»,
# иначе ключ умирает через 7 дней.
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# Любая случайная строка: Vercel передаёт её в ежедневный запуск автопилота (/api/cron).
CRON_SECRET=

# Уведомления на телефон (Web Push). Все четыре строки печатает (из папки video-studio):
#   npx tsx panel/scripts/vapid-keys.ts ваша@почта.ru
# Пара ключей VAPID: открытый — для подписки устройств, закрытый — подпись каждого уведомления
# (только здесь, не в git). Новая пара отключает подписанные устройства — включите их заново.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Адрес для связи со службой push: mailto:почта или https://… (без него Apple не принимает).
VAPID_SUBJECT=
# Ключ для POST /api/notify (уведомление «видео готово» из workflow): Authorization: Bearer <ключ>.
# Можно не задавать — тогда подходит CRON_SECRET.
PANEL_NOTIFY_SECRET=

# TikTok — статистика на странице «TikTok» (video-studio/docs/tiktok-setup.md). Приложение на
# developers.tiktok.com в режиме Sandbox, продукт Login Kit (Web), Redirect URI:
# https://<адрес панели>/api/tiktok/callback. Без этих двух строк страница покажет, как подключить.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Необязательно: другой адрес возврата (если панель открывают по своему домену) и права через запятую.
TIKTOK_REDIRECT_URI=
TIKTOK_SCOPES=
