# video-studio — настройки. Скопируйте в .env (рядом с этим файлом) и заполните
# нужное. Пустая строка = значение по умолчанию. Файл .env в git не попадает.
# В GitHub Actions ключи задаются как Secrets, а настройки — как Variables; workflow читает
# не все имена отсюда — список в README.md, раздел «GitHub Actions».
#
# Минимум для «тема → ролик» бесплатно: GEMINI_API_KEY (сценарий) — и всё.
# Озвучка Edge и Piper работает без ключей. Визуал без ключей — только реальные фото
# Wikimedia/Openverse по теме, остальное — моушен-графика; с PEXELS_API_KEY — живые видео.

# ───────────────────────── Сценарий (LLM) ─────────────────────────
# gemini | claude | groq | openrouter | ollama | custom   (по умолчанию gemini — бесплатно)
LLM_PROVIDER=
# Модель вместо умолчания провайдера (например, claude-sonnet-5-5 — вдвое дешевле Opus)
LLM_MODEL=
# Google AI Studio — один ключ и для сценариев, и для Gemini TTS. Бесплатно:
#   https://aistudio.google.com/app/apikey   (GOOGLE_API_KEY тоже понимается)
GEMINI_API_KEY=
# Необязательно: второй ключ только для озвучки Gemini TTS — из ДРУГОГО проекта (проще всего другого
# аккаунта Google): лимиты (~10 озвучек в сутки на модель) считаются на проект, а не на ключ, так что
# второй ключ того же проекта ничего не даст. Кончилась суточная квота основного — та же модель
# озвучит вторым ключом, и только потом — запасная модель. Пусто — как с одним ключом.
# Ключ — как пароль: никому не присылайте его в чат, вставляйте только сюда или в секрет GitHub.
GEMINI_API_KEY_2=
# Claude (платно, по факту использования): https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Запасные бесплатные: https://console.groq.com/keys , https://openrouter.ai/keys (модели :free)
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Запасная цепочка через запятую, например "groq,openrouter:google/gemma-4-31b-it:free"; none — без запасных.
# По умолчанию — все бесплатные провайдеры, для которых задан ключ.
LLM_FALLBACKS=
# Claude: low | medium | high | xhigh | max (по умолчанию medium)
LLM_EFFORT=
# Таймаут одного запроса к LLM, мс
LLM_TIMEOUT_MS=
# Локальная модель: LLM_PROVIDER=ollama (ollama serve; ollama pull gemma4:12b)
OLLAMA_BASE_URL=
# LLM_PROVIDER=custom — любой OpenAI-совместимый сервер
LLM_BASE_URL=
LLM_API_KEY=
# Подсказки поиска YouTube для заголовка и тегов (бесплатно, без ключа): 0 — выключить; таймаут, мс (4000)
YT_SUGGEST=
YT_SUGGEST_TIMEOUT_MS=
# Журнал расхода LLM и TTS (content/usage.jsonl): 0 — не писать, путь — свой файл
USAGE_LOG=
# npm run plan-extend / plan-sequel: 0 — без веб-поиска источников у Claude ($10 за 1000 поисков);
# 0 — не проверять ссылки фактов по сети; таймаут проверки одной ссылки, мс (8000)
PLAN_WEB_SEARCH=
PLAN_CHECK_URLS=
PLAN_URL_TIMEOUT_MS=

# ───────────────────────── Озвучка ─────────────────────────
# auto | gemini | edge | piper | elevenlabs | openai | fish   (по умолчанию auto: gemini, если есть GEMINI_API_KEY, иначе edge)
#   edge       — Microsoft Edge, бесплатно, без ключа, неофициальный API (может перестать работать)
#   piper      — офлайн на процессоре, модель (~60 МБ) скачается сама; качество проще
#   gemini     — Google AI Studio, самый живой бесплатный; квота ≈ 10 запросов/сутки на модель,
#                поэтому весь ролик озвучивается ОДНИМ запросом и режется по паузам (≈ 10 шортов в сутки)
#   elevenlabs — лучшее качество; бесплатный план — БЕЗ коммерческих прав (монетизация — от $5/мес)
#   openai     — свой сервер /v1/audio/speech: Qwen3-TTS (Apache-2.0, клон голоса), Chatterbox
#   fish       — локальный Fish Speech (веса — некоммерческая лицензия)
TTS_PROVIDER=
# Голос: gemini — Charon (по умолчанию) | Puck | Fenrir | Kore | Aoede | Zephyr …;
#   edge — ru-RU-DmitryNeural | ru-RU-SvetlanaNeural; piper — ru_RU-dmitri-medium | denis | irina | ruslan
#   (лицензии датасетов Piper: dmitri и denis — CC0, irina — не указана, ruslan — CC BY-NC-SA, только некоммерчески)
TTS_VOICE=
# Темп речи, например +5% или -10%
TTS_RATE=
# Язык озвучки: en, kk, uz… (обычно не нужен — make берёт его из сценария; пусто — ru).
# Для него голос Edge/Piper по умолчанию: en-US-ChristopherNeural, kk-KZ-DauletNeural, uz-UZ-SardorNeural
TTS_LANGUAGE=
# Запасные провайдеры через запятую, если основной не отвечает (по умолчанию: gemini → edge,piper; edge → piper).
# Ролик всегда переозвучивается целиком, голоса не смешиваются; кто озвучил — в qc.json и result.json (поле voice).
# none — не подменять: кончилась квота Gemini — сборка падает («квота Gemini закончилась — ролик соберётся
# при повторе»). Так запускает автопилот панели (поле voice_fallback = none в workflow).
TTS_FALLBACK=
# Таймаут синтеза одной сцены, мс (edge 30000, сетевые 120000–180000)
TTS_TIMEOUT_MS=
# 0 — не переиспользовать уже озвученные сцены при повторной сборке (ни из папки ролика, ни из общего кэша):
# новый дубль вместо прежнего (оговорка, обрезанное слово), он же заменит запись общего кэша.
# В GitHub — переменная репозитория TTS_CACHE = 0 на одну пересборку, потом удалить.
TTS_CACHE=
# Общий кэш озвучки между запусками и папками роликов (по умолчанию ./.cache/voice; none — выключить).
# Ключ — провайдер, голос, модель и стиль, текст сцены: тот же текст не тратит квоту Gemini второй раз.
# В GitHub Actions папку сохраняет actions/cache.
TTS_CACHE_DIR=
# Сколько дней хранить записи общего кэша (по умолчанию 14)
TTS_CACHE_DAYS=
# HTTP(S)-прокси только для Edge TTS
EDGE_PROXY=
# Куда скачивать локальные модели: голоса Piper и распознавание речи для таймингов (по умолчанию ./models)
MODELS_DIR=
# Тайминги слов по распознанной речи (GigaAM v2, MIT, офлайн, ~170 МБ один раз) для Piper/Gemini/… ; 0 (или false/no/off/none) — оценка по звуку
CAPTION_ALIGN=
# Gemini TTS (ключ — GEMINI_API_KEY выше, запасной — GEMINI_API_KEY_2). Голос и манера по умолчанию — voice.name / voice.style из channel.json
GEMINI_TTS_MODEL=
GEMINI_TTS_VOICE=
GEMINI_TTS_STYLE=
# Сколько символов текста отправлять одним запросом Gemini (шорт ≈ 800; по умолчанию 2500)
GEMINI_TTS_BATCH_CHARS=
# ElevenLabs: https://elevenlabs.io/app/settings/api-keys ; голос с русским — в Voice Library
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=
ELEVENLABS_OUTPUT_FORMAT=
# OpenAI-совместимый TTS-сервер (по умолчанию http://localhost:8091/v1)
OPENAI_TTS_BASE_URL=
OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE=
OPENAI_TTS_API_KEY=
# vLLM-Omni / Qwen3-TTS: язык ("Russian"), инструкции по стилю, 1 — запросить тайминги слов
OPENAI_TTS_LANGUAGE=
OPENAI_TTS_INSTRUCTIONS=
OPENAI_TTS_WORD_TIMESTAMPS=
# Fish Speech (по умолчанию http://127.0.0.1:8080)
FISH_TTS_BASE_URL=
FISH_TTS_REFERENCE_ID=
FISH_TTS_API_KEY=

# ───────────────────────── Визуал ─────────────────────────
# Как подбираются кадры и что делать, если они не по теме, — docs/visuals.md.
# Порядок источников: pexels,pixabay,wikimedia,openverse,cloudflare,pollinations или none
# (по умолчанию pexels,pixabay,wikimedia,openverse,cloudflare). Источник без ключа просто
# пропускается; кадр не по теме не берётся — сцена остаётся чистой моушен-графикой.
VISUALS=
# Бесплатно: https://www.pexels.com/api/  (200 запросов/час) — живые видео по теме, лучше всего
PEXELS_API_KEY=
# Бесплатно: https://pixabay.com/api/docs/  (после входа ключ показан на странице)
PIXABAY_API_KEY=
# Реальные фото (Wikimedia Commons, Openverse — без ключа): короткая сторона фото с Commons,
# px (по умолчанию 1080); лицензии pd,cc0,cc-by,cc-by-sa (по умолчанию все четыре);
# User-Agent с вашим контактом; рубрики, где реальные фото идут первыми (history,nature,space)
VISUALS_MIN_PHOTO_PX=
WIKIMEDIA_LICENSES=
WIKIMEDIA_USER_AGENT=
VISUALS_REAL_PILLARS=
# Судья Claude для кадров — ПЛАТНО, по умолчанию выключен: claude + ANTHROPIC_API_KEY.
# Читает русский текст сцены и выбирает кадр по смыслу; ≈ $0.01–0.02 за Shorts на
# claude-haiku-4-5 (по умолчанию). Модель и таймаут, мс (по умолчанию 20000):
VISUALS_JUDGE=
VISUALS_JUDGE_MODEL=
VISUALS_JUDGE_TIMEOUT_MS=
# AI-картинки Cloudflare Workers AI (бесплатная суточная квота): dash.cloudflare.com →
# Account ID на главной; API Tokens → шаблон «Workers AI»
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=
# Кинорежим. Проверка кадров зрением Claude — ПЛАТНО, включена при ANTHROPIC_API_KEY
# (off — выключить): коллажи, жуть, надписи, «не о том», другой герой → перегенерация;
# ≈ $0.10 за ролик на claude-opus-5-5 (по умолчанию). Сколько раз перегенерировать брак (1):
VISUALS_REVIEW=
VISUALS_REVIEW_MODEL=
VISUALS_REVIEW_ROUNDS=
# Новых AI-картинок на ролик, не больше (16): остальные планы повторяют кадр своей сцены
VISUALS_AI_MAX_FRAMES=
# Общий кэш AI-кадров и вердиктов проверки (по умолчанию .cache/visuals-ai; off — без кэша)
VISUALS_AI_CACHE_DIR=
VISUALS_AI_CACHE=
# Pollinations без ключа: сколько секунд всего ждать лимита «1 картинка в 45 с» на кадр (100)
POLLINATIONS_WAIT_MAX_SEC=
# image — только фото (легче скачивать и рендерить на слабом ПК)
VISUALS_PREFER=
# Стиль, дописываемый к промптам AI-картинок
VISUALS_STYLE=
VISUALS_TIMEOUT_MS=
VISUALS_DOWNLOAD_TIMEOUT_MS=
VISUALS_GEN_TIMEOUT_MS=
# Лимиты размера скачиваемых файлов, МБ (по умолчанию 60 и 15)
VISUALS_MAX_VIDEO_MB=
VISUALS_MAX_IMAGE_MB=
# Кэш ответов Pixabay (по умолчанию ./.cache)
VISUALS_CACHE_DIR=

# ───────────────────────── Музыка и звук ─────────────────────────
# auto (трек из MUSIC_DIR, иначе сгенерированный эмбиент) | none | generated | путь к файлу
MUSIC=
# Папка с треками (по умолчанию ./music, см. music/README.md про лицензии)
MUSIC_DIR=
# calm | inspiring | upbeat | tech | dark (по умолчанию — по названию ролика)
MUSIC_MOOD=
# Громкость музыки 0–1 (по умолчанию 0.22 для сгенерированной, ~0.16 для треков); под голосом — ×0.32
MUSIC_VOLUME=
# Громкость звука перехода 0–1 (по умолчанию 0.35)
SFX_VOLUME=

# ───────────────────────── Рендер ─────────────────────────
# Имя канала в финальной сцене «Подпишись» (по умолчанию — name из channel.json)
CHANNEL_NAME=
# Подпись к «облачку» комментария в финальной сцене (по умолчанию — cta.onScreenComment из channel.json); off — убрать
CTA_COMMENT=
# Свой Chrome/Chromium вместо автоматически скачанного Chrome Headless Shell:
#   путь к файлу + режим headless-shell | chrome-for-testing (обычный Chrome/Chromium)
REMOTION_BROWSER_EXECUTABLE=
REMOTION_CHROME_MODE=
# Сколько кадров рендерить параллельно (по умолчанию — половина ядер)
RENDER_CONCURRENCY=
# Итоговая громкость ролика, LUFS (по умолчанию -14 — ориентир YouTube; тихие ролики YouTube не поднимает).
# Только статическое усиление, пик не выше -1.5 dBTP. off — не трогать.
LOUDNESS_TARGET=

# ───────────────────────── YouTube ─────────────────────────
# OAuth-клиент «Desktop app» из Google Cloud Console + токен из npm run youtube-auth (см. README)
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
# Категория (27 — «Образование», 28 — «Наука и техника», 22 — «Люди и блоги»)
YT_CATEGORY_ID=
# Отметка «Изменённый или синтетический контент» (по умолчанию 1 — голос синтезирован); 0 — не ставить
YT_SYNTHETIC_MEDIA=

# ───────────────────────── Канал и расписание ─────────────────────────
# Название, голос, хэштеги, призывы, ссылки, дисклеймер и слоты публикации берутся из channel.json.
# Другой файл канала (путь от папки video-studio) или none — работать без него
CHANNEL_FILE=
# Слоты публикации для --schedule вместо channel.json, через запятую (по умолчанию 12:00,19:00)
PUBLISH_TIMES=
# Часовой пояс слотов, IANA (по умолчанию Europe/Moscow из channel.json)
PUBLISH_TZ=

# ───────────────────────── Instagram (Reels) ─────────────────────────
# Официальный API, вариант «Instagram API with Facebook Login for Business» (graph.facebook.com):
# только он загружает файл без публичной ссылки. Пошагово: docs/instagram-setup.md
# Числовой id Instagram-аккаунта (не @ник): npm run instagram-token покажет его
IG_USER_ID=
# Токен EAA… (пользователя ~60 дней или страницы — бессрочный): npm run instagram-token -- --exchange --page
IG_ACCESS_TOKEN=
# Только для продления токена (npm run instagram-token -- --exchange): приложение → Настройки → Основное
IG_APP_ID=
IG_APP_SECRET=
# Версия Graph API (по умолчанию v26.0) и хост (по умолчанию graph.facebook.com)
IG_API_VERSION=
IG_API_HOST=
# Пометка «создано с помощью ИИ» у Reels (по умолчанию 1 — голос синтезирован); 0 — не ставить
IG_AI_GENERATED=

# ───────────────────────── Telegram (канал) ─────────────────────────
# Кросспостинг ролика в канал через официальный Bot API (npm run upload -- out/<имя> --to telegram).
# Пошагово: docs/telegram-setup.md. Проверить настройки и узнать id канала: npm run telegram-check
# Токен бота от @BotFather (вида 123456789:AAH…); бот — администратор канала с правом «Публикация сообщений»
TELEGRAM_BOT_TOKEN=
# Канал: -100… (закрытый) или @имя (публичный)
TELEGRAM_CHAT_ID=
