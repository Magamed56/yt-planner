# video-studio — настройки. Скопируйте в .env (рядом с этим файлом) и заполните
# нужное. Пустая строка = значение по умолчанию. Файл .env в git не попадает.
# В GitHub Actions ключи задаются как Secrets, а настройки — как Variables; workflow читает
# не все имена отсюда — список в README.md, раздел «GitHub Actions».
#
# Минимум для «тема → ролик» бесплатно: GEMINI_API_KEY (сценарий) — и всё.
# Озвучка Edge и Piper работает без ключей, визуал без ключей — чистая моушен-графика.

# ───────────────────────── Сценарий (LLM) ─────────────────────────
# gemini | claude | groq | openrouter | ollama | custom   (по умолчанию gemini — бесплатно)
LLM_PROVIDER=
# Модель вместо умолчания провайдера (например, claude-sonnet-5-5 — вдвое дешевле Opus)
LLM_MODEL=
# Google AI Studio — один ключ и для сценариев, и для Gemini TTS. Бесплатно:
#   https://aistudio.google.com/app/apikey   (GOOGLE_API_KEY тоже понимается)
GEMINI_API_KEY=
# Claude (платно, по факту использования): https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Запасные бесплатные: https://console.groq.com/keys , https://openrouter.ai/keys (модели :free)
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Запасная цепочка через запятую, например "groq,openrouter:google/gemma-4-31b-it:free"; none — без запасных.
# По умолчанию — все бесплатные провайдеры, для которых задан ключ.
LLM_FALLBACKS=
# Claude: low | medium | high | xhigh | max (по умолчанию medium)
LLM_EFFORT=
# Таймаут одного запроса к LLM, мс
LLM_TIMEOUT_MS=
# Локальная модель: LLM_PROVIDER=ollama (ollama serve; ollama pull gemma4:12b)
OLLAMA_BASE_URL=
# LLM_PROVIDER=custom — любой OpenAI-совместимый сервер
LLM_BASE_URL=
LLM_API_KEY=

# ───────────────────────── Озвучка ─────────────────────────
# auto | gemini | edge | piper | elevenlabs | openai | fish   (по умолчанию auto: gemini, если есть GEMINI_API_KEY, иначе edge)
#   edge       — Microsoft Edge, бесплатно, без ключа, неофициальный API (может перестать работать)
#   piper      — офлайн на процессоре, модель (~60 МБ) скачается сама; качество проще
#   gemini     — Google AI Studio, самый живой бесплатный; квота ≈ 10 запросов/сутки на модель,
#                поэтому весь ролик озвучивается ОДНИМ запросом и режется по паузам (≈ 10 шортов в сутки)
#   elevenlabs — лучшее качество; бесплатный план — БЕЗ коммерческих прав (монетизация — от $5/мес)
#   openai     — свой сервер /v1/audio/speech: Qwen3-TTS (Apache-2.0, клон голоса), Chatterbox
#   fish       — локальный Fish Speech (веса — некоммерческая лицензия)
TTS_PROVIDER=
# Голос: gemini — Charon (по умолчанию) | Puck | Fenrir | Kore | Aoede | Zephyr …;
#   edge — ru-RU-DmitryNeural | ru-RU-SvetlanaNeural; piper — ru_RU-dmitri-medium | denis | irina | ruslan
#   (лицензии датасетов Piper: dmitri и denis — CC0, irina — не указана, ruslan — CC BY-NC-SA, только некоммерчески)
TTS_VOICE=
# Темп речи, например +5% или -10%
TTS_RATE=
# Запасные провайдеры через запятую, если основной не отвечает (по умолчанию: gemini → edge,piper; edge → piper).
# Ролик всегда переозвучивается целиком, голоса не смешиваются. none — не подменять.
TTS_FALLBACK=
# Таймаут синтеза одной сцены, мс (edge 30000, сетевые 120000–180000)
TTS_TIMEOUT_MS=
# 0 — не переиспользовать уже озвученные сцены при повторной сборке
TTS_CACHE=
# HTTP(S)-прокси только для Edge TTS
EDGE_PROXY=
# Куда скачивать модели Piper (по умолчанию ./models)
MODELS_DIR=
# Gemini TTS (ключ — GEMINI_API_KEY выше)
GEMINI_TTS_MODEL=
GEMINI_TTS_VOICE=
GEMINI_TTS_STYLE=
# Сколько символов текста отправлять одним запросом Gemini (шорт ≈ 800; по умолчанию 2500)
GEMINI_TTS_BATCH_CHARS=
# ElevenLabs: https://elevenlabs.io/app/settings/api-keys ; голос с русским — в Voice Library
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=
ELEVENLABS_OUTPUT_FORMAT=
# OpenAI-совместимый TTS-сервер (по умолчанию http://localhost:8091/v1)
OPENAI_TTS_BASE_URL=
OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE=
OPENAI_TTS_API_KEY=
# vLLM-Omni / Qwen3-TTS: язык ("Russian"), инструкции по стилю, 1 — запросить тайминги слов
OPENAI_TTS_LANGUAGE=
OPENAI_TTS_INSTRUCTIONS=
OPENAI_TTS_WORD_TIMESTAMPS=
# Fish Speech (по умолчанию http://127.0.0.1:8080)
FISH_TTS_BASE_URL=
FISH_TTS_REFERENCE_ID=
FISH_TTS_API_KEY=

# ───────────────────────── Визуал ─────────────────────────
# Порядок источников: pexels,pixabay,cloudflare,pollinations или none (по умолчанию pexels,pixabay,cloudflare).
# Источник без ключа просто пропускается; без визуала сцена — чистая моушен-графика.
VISUALS=
# Бесплатно: https://www.pexels.com/api/  (200 запросов/час)
PEXELS_API_KEY=
# Бесплатно: https://pixabay.com/api/docs/  (после входа ключ показан на странице)
PIXABAY_API_KEY=
# AI-картинки Cloudflare Workers AI (бесплатная суточная квота): dash.cloudflare.com →
# Account ID на главной; API Tokens → шаблон «Workers AI»
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=
# image — только фото (легче скачивать и рендерить на слабом ПК)
VISUALS_PREFER=
# Стиль, дописываемый к промптам AI-картинок
VISUALS_STYLE=
VISUALS_TIMEOUT_MS=
VISUALS_DOWNLOAD_TIMEOUT_MS=
VISUALS_GEN_TIMEOUT_MS=
# Лимиты размера скачиваемых файлов, МБ (по умолчанию 60 и 15)
VISUALS_MAX_VIDEO_MB=
VISUALS_MAX_IMAGE_MB=
# Кэш ответов Pixabay (по умолчанию ./.cache)
VISUALS_CACHE_DIR=

# ───────────────────────── Музыка и звук ─────────────────────────
# auto (трек из MUSIC_DIR, иначе сгенерированный эмбиент) | none | generated | путь к файлу
MUSIC=
# Папка с треками (по умолчанию ./music, см. music/README.md про лицензии)
MUSIC_DIR=
# calm | inspiring | upbeat | tech | dark (по умолчанию — по названию ролика)
MUSIC_MOOD=
# Громкость музыки 0–1 (по умолчанию 0.22 для сгенерированной, ~0.16 для треков); под голосом — ×0.32
MUSIC_VOLUME=
# Громкость звука перехода 0–1 (по умолчанию 0.35)
SFX_VOLUME=

# ───────────────────────── Рендер ─────────────────────────
# Имя канала в финальной сцене «Подпишись»
CHANNEL_NAME=
# Свой Chrome/Chromium вместо автоматически скачанного Chrome Headless Shell:
#   путь к файлу + режим headless-shell | chrome-for-testing (обычный Chrome/Chromium)
REMOTION_BROWSER_EXECUTABLE=
REMOTION_CHROME_MODE=
# Сколько кадров рендерить параллельно (по умолчанию — половина ядер)
RENDER_CONCURRENCY=
# Итоговая громкость ролика, LUFS (по умолчанию -14 — ориентир YouTube; тихие ролики YouTube не поднимает).
# Только статическое усиление, пик не выше -1.5 dBTP. off — не трогать.
LOUDNESS_TARGET=

# ───────────────────────── YouTube ─────────────────────────
# OAuth-клиент «Desktop app» из Google Cloud Console + токен из npm run youtube-auth (см. README)
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
# Категория (27 — «Образование», 28 — «Наука и техника», 22 — «Люди и блоги»)
YT_CATEGORY_ID=
# Отметка «Изменённый или синтетический контент» (по умолчанию 1 — голос синтезирован); 0 — не ставить
YT_SYNTHETIC_MEDIA=
